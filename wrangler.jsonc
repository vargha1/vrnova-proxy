{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vrnova-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a72d68cb-fa64-45b7-a9af-7406f69d3607","database_name": "vrnova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "ceadfba2ea734b0ba07675ab798eeaf9" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
